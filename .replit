modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["android-tools", "dbus", "fontconfig", "freetype", "iana-etc", "libGL", "libxkbcommon", "mesa", "xorg.libX11", "xorg.libXext", "xorg.libXrender", "xorg.libxcb", "xorg.xcbutilcursor", "zstd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ADB Log CLI"

[[workflows.workflow]]
name = "ADB Log CLI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python adb_log_cli.py"

[workflows.workflow.metadata]
outputType = "console"
